# ── Backend ──────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://sesale:sesale@localhost:5432/sesale
# DATABASE_URL=sqlite:///./sesale.db  # Etapa 1 local, ya no se usa (ver docker-compose.yml)

# Auth JWT propia (Etapa 3). NO usar el mismo valor en producción.
SECRET_KEY=cambiame-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

MERCADOPAGO_ACCESS_TOKEN=tu-access-token
MERCADOPAGO_WEBHOOK_SECRET=tu-webhook-secret

ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,https://sesale.com.ar

# ── Frontend (Next.js — NEXT_PUBLIC_ se expone al cliente) ──
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MP_PUBLIC_KEY=tu-public-key-de-mp
