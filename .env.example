# ── Backend ──────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://sesale:sesale@localhost:5432/sesale
# DATABASE_URL=sqlite:///./sesale.db  # Etapa 1 local, ya no se usa (ver docker-compose.yml)
# En Railway: la URL de conexión de tu proyecto Postgres (Railway la arma sola
# si agregás el plugin de Postgres) — reemplazala por la de Supabase si migrás
# la DB ahí (Settings → Database → Connection string → Mode: URI). SIEMPRE
# con el driver +psycopg (el proyecto no usa asyncpg/SQLAlchemy async).
# Pool de conexiones por worker (opcional, defaults 5/5). Pensado para Supabase
# Free (t4g.nano, max_connections=60, ~15 usadas por Supabase): 10 por worker
# x 2 workers = 20. Si se sube de compute, recalcular contra el nuevo límite.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# Auth JWT propia (Etapa 3). Generar un valor random para cada entorno con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NUNCA usar el mismo valor en dos entornos (local/staging/producción),
# nunca commitear el valor real, nunca compartirlo fuera de Railway.
SECRET_KEY=cambiame-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Credenciales de tu cuenta de MercadoPago (developers.mercadopago.com →
# Tus integraciones → la app → Credenciales). Usar SIEMPRE credenciales
# TEST-... en local y staging; APP_USR-... (producción real) solo en el
# entorno de producción — nunca antes de estar realmente por cobrar.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Panel de MP → esa misma app → Webhooks → "Firma secreta" del webhook que
# apunta a POST /api/webhooks/mercadopago. Una por credencial (test/prod).
MERCADOPAGO_WEBHOOK_SECRET=

# Login con Google (ID token, sin client secret) — POST /api/auth/google.
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (tipo "Web application"). Sin esta variable, el login con Google queda
# desactivado del lado del backend (ver app/core/google_oauth.py). Debe
# coincidir EXACTAMENTE con NEXT_PUBLIC_GOOGLE_CLIENT_ID (frontend, más
# abajo): es el mismo Client ID de Google, no un secreto — el backend lo usa
# solo para validar el campo `aud` del token que ya firmó Google.
GOOGLE_CLIENT_ID=

# Número de WhatsApp de contacto de seSALE (con código de país, sin +),
# usado por el botón "Consultar" del plan Banner. Ej: 5492994000000
SESALE_WHATSAPP=549XXXXXXXXXX

# URLs propias usadas para armar back_urls y notification_url de MercadoPago,
# y el link al panel admin en el email de reporte de eventos.
# Local: los de abajo. Staging/producción: la URL pública real de Vercel/Railway
# de ese entorno (nunca localhost).
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# Envío de emails con Resend (resend.com) — reporte de eventos (Etapa 6.5).
# RESEND_API_KEY: Resend → API Keys → Create API Key.
# ADMIN_EMAIL: dirección que recibe el email cuando alguien reporta un evento.
RESEND_API_KEY=
ADMIN_EMAIL=tu@email.com
# RESEND_FROM_EMAIL: remitente de todos los emails, formato "Nombre <direccion>".
# Sin dominio verificado en Resend usar "seSALE <onboarding@resend.dev>" (es el
# default si se deja vacío); con dominio verificado, una dirección de ese dominio.
# RESEND_REPLY_TO: opcional — casilla donde caen las respuestas (vacío = sin reply-to).
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# Supabase Storage — flyers/banners/portadas (Etapas 8b/8d/8e). El bucket
# debe ser público. Sin estas variables, storage.py cae a guardar los
# archivos en apps/api/uploads/ (solo development, no persiste en Railway).
# SUPABASE_URL / SUPABASE_SERVICE_KEY: supabase.com → tu proyecto →
# Settings → API ("Project URL" y "service_role" — NUNCA la "anon" key,
# necesita permisos de escritura en Storage).
# Un proyecto Supabase POR ENTORNO (staging y producción NUNCA comparten
# el mismo, ver README.md → Guía de deploy).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=flyers
SUPABASE_BANNER_BUCKET=banners
SUPABASE_COVER_BUCKET=covers

# development | staging | production — production activa el guard de
# core/config.py que rechaza arrancar si SECRET_KEY sigue siendo el valor
# de desarrollo (Etapa 9c).
ENVIRONMENT=development
# Orígenes exactos permitidos por CORS, separados por coma. NUNCA "*" en
# staging/producción — solo el dominio de Vercel de ESE entorno + el
# dominio propio si ya está enganchado.
ALLOWED_ORIGINS=http://localhost:3000,https://sesale.com.ar

# Setup del primer admin (Etapa 9d) — POST /api/setup/admin se auto-desactiva
# (410) apenas existe un admin. Setear a "true" en Railway después de crear
# el primer admin de ESE entorno, como capa extra de seguridad.
DISABLE_SETUP_ENDPOINT=false

# Auditoría post-lanzamiento — mitigación de X-Forwarded-For spoofing (ver
# a_revisar.md, "Auditoría de seguridad post-lanzamiento"). Opcional: vacío =
# sin cambios de comportamiento. Si se configura, DEBE tener el MISMO valor acá
# (Railway, backend) y en PROXY_SHARED_SECRET del frontend (Vercel) — generar
# con: python -c "import secrets; print(secrets.token_hex(32))"
PROXY_SHARED_SECRET=

# ── Frontend (Next.js — NEXT_PUBLIC_ se expone al cliente, nunca poner acá
#    nada que no deba ser público) ──
NEXT_PUBLIC_API_URL=http://localhost:8000
# No se usa en Etapa 6 (checkout de MercadoPago es redirect, no Bricks) —
# documentada por si se retoma. Es de solo lectura, segura de exponer.
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Mismo número que SESALE_WHATSAPP, pero expuesto al cliente (botón "Consultar"
# del plan Banner y contacto de soporte en /planes/pago-fallido)
NEXT_PUBLIC_SESALE_WHATSAPP=549XXXXXXXXXX

# Mismo Client ID que GOOGLE_CLIENT_ID del backend (ver arriba) — lo usa
# GoogleLoginButton.tsx para renderizar el botón de Google Identity Services.
# Es público a propósito (cualquier Client ID de OAuth lo es, Google lo
# expone igual en el HTML de cualquier sitio que lo use).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# El alias de pago por transferencia ya no es una variable de entorno: se
# carga desde el panel admin → Configuración (tabla `site_settings`). Ver
# a_revisar.md, "Fix: flujo de pago por transferencia".

# Modo mantenimiento (Etapa 9d) — "true" muestra /proximamente a todos
# salvo /login y /api. NEXT_PUBLIC_ porque el middleware corre en el edge
# runtime, sin acceso a variables de servidor. No es sensible (solo un bool).
# Pensado para estar en "true" en staging hasta el lanzamiento público, y
# en "false" en producción desde el día del lanzamiento.
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Fecha de lanzamiento para el countdown de /proximamente (opcional).
# Formato ISO: 2025-06-01T00:00:00-03:00. Vacío = no se muestra countdown.
NEXT_PUBLIC_LAUNCH_DATE=

# Mismo valor que PROXY_SHARED_SECRET del backend (ver arriba) — SIN
# NEXT_PUBLIC_, es server-only: el middleware (src/middleware.ts) lo agrega
# como header antes del rewrite a /api/*, nunca se expone al browser.
PROXY_SHARED_SECRET=
